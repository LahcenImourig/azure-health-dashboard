  "DailyReportLambdaD20B30F7": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nconst { SecretsManagerClient, GetSecretValueCommand } = require('@aws-sdk/client-secrets-manager');\n\nexports.handler = async () => {\n  const sm = new SecretsManagerClient({});\n  const secretResp = await sm.send(new GetSecretValueCommand({ SecretId: process.env.SECRETS_ARN }));\n  const secrets = JSON.parse(secretResp.SecretString);\n  const cronSecret = secrets.CRON_SECRET;\n  const dashboardUrl = process.env.DASHBOARD_URL;\n\n  console.log('Triggering daily report at', new Date().toISOString());\n\n  const response = await fetch(dashboardUrl + '/api/report/generate', {\n    method: 'POST',\n    headers: {\n      'Authorization': 'Bearer ' + cronSecret,\n      'Content-Type': 'application/json',\n    },\n  });\n\n  if (!response.ok) {\n    const body = await response.text();\n    throw new Error('Report API returned ' + response.status + ': ' + body);\n  }\n\n  const result = await response.json();\n  console.log('Report sent successfully');\n  return { statusCode: 200, body: JSON.stringify(result) };\n};\n      "
    },
    "Environment": {
     "Variables": {
      "DASHBOARD_URL": {
       "Fn::Join": [
        "",
        [
         "https://",
         {
          "Fn::GetAtt": [
           "AppRunnerService",
           "ServiceUrl"
          ]
         }
        ]
       ]
      },
      "SECRETS_ARN": {
       "Ref": "AppSecretsA1997F2A"
      }
     }
    },
    "FunctionName": "azure-health-dashboard-daily-report",
    "Handler": "index.handler",
    "LoggingConfig": {
     "LogGroup": {
      "Ref": "ReportLambdaLogsE26809BB"
     }
    },
    "Role": {
     "Fn::GetAtt": [
      "ReportLambdaRoleA69C9B03",
      "Arn"
     ]
    },
    "Runtime": "nodejs20.x",
    "Timeout": 60
   },
   "DependsOn": [
    "ReportLambdaRoleDefaultPolicyBD461524",
    "ReportLambdaRoleA69C9B03"
   ],
   "Metadata": {
    "aws:cdk:path": "azure-health-dashboard-stack/DailyReportLambda/Resource"
   }
  },
